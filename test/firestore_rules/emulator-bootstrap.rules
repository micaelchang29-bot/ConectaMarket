// Placeholder SOLO para que el CLI pueda arrancar el emulador: exige una ruta
// de reglas dentro del directorio del config. Las reglas que realmente se
// prueban las carga rules.test.js desde ../../firestore.rules via
// initializeTestEnvironment({firestore: {rules: ...}}), que las sube al
// emulador y reemplaza a estas. Deniega todo a proposito: si alguna vez un
// test pasara contra ESTE archivo, el resultado seria un falso negativo
// evidente (todo denegado), nunca un falso positivo.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
